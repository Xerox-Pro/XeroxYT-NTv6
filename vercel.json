{
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://xeroxyt-v6-api.2026-97th.workers.dev/api/:path*"
    },
    {
      "source": "/stream/:path*",
      "destination": "https://xeroxyt-v6-api.2026-97th.workers.dev/stream/:path*"
    },
    {
      "source": "/360/:path*",
      "destination": "https://xeroxyt-v6-api.2026-97th.workers.dev/360/:path*"
    },
    {
      "source": "/edu/:path*",
      "destination": "https://xeroxyt-v6-api.2026-97th.workers.dev/edu/:path*"
    },
    {
      "source": "/scratch-edu/:path*",
      "destination": "https://xeroxyt-v6-api.2026-97th.workers.dev/scratch-edu/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js|index.html|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
