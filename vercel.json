{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/(stream|360|edu|scratch-edu)/([A-Za-z0-9_-]+)",
      "dest": "/api/playback-gateway?route=/$1/$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path]"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
