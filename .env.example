# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: GitHub Classic API Key for saving user data via WebAuthn
GITHUB_TOKEN=
# GITHUB_USERNAME: GitHub Username for the repo
GITHUB_USERNAME=
# GITHUB_REPO: Repository name to save user data (e.g. "my-app-data")
GITHUB_REPO=
# ENCRYPTION_KEY: Secret key used to encrypt the user data (32 chars recommended)
ENCRYPTION_KEY=

# Vercel Serverless & Bandwidth Protection Quotas (Daily Limits)
DAILY_VIDEO_LIMIT=10
DAILY_SEARCH_LIMIT=20
DAILY_TOTAL_LIMIT=600
BURST_LIMIT_PER_MINUTE=80
LIMIT_SECRET=
