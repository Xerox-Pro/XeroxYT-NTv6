{
  "name": "xeroxyt-v6-api",
  "main": "bundle.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "ACCOUNT",
      "service": "xeroxyt-account"
    },
    {
      "binding": "STREAM",
      "service": "xeroxyt-stream-proxy"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xeroxyt-accounts",
      "database_id": "7bf1a341-ca3c-426a-b4dd-07da4a8d2528"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "no_bundle": true
}
